{
  "name": "@egcs/newui",
  "version": "0.1.0-alpha.6",
  "description": "Composable SolidJS components with shared design tokens, automatic themes, and optional Tailwind integration.",
  "license": "MIT",
  "homepage": "https://github.com/bearkfear/newui#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bearkfear/newui.git",
    "directory": "workspace/pkgs/ui"
  },
  "bugs": {
    "url": "https://github.com/bearkfear/newui/issues"
  },
  "keywords": [
    "solid-js",
    "components",
    "design-system",
    "tailwindcss",
    "ark-ui",
    "radix-colors"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "next",
    "registry": "https://registry.npmjs.org"
  },
  "type": "module",
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "solid": "./dist/index.jsx",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./charts": {
      "types": "./dist/types/data/chart/index.d.ts",
      "solid": "./dist/charts.jsx",
      "import": "./dist/charts.js"
    },
    "./actions": {
      "types": "./dist/types/actions/index.d.ts",
      "solid": "./dist/actions.jsx",
      "import": "./dist/actions.js"
    },
    "./compositions": {
      "types": "./dist/types/compositions/index.d.ts",
      "solid": "./dist/compositions.jsx",
      "import": "./dist/compositions.js"
    },
    "./content": {
      "types": "./dist/types/content/index.d.ts",
      "solid": "./dist/content.jsx",
      "import": "./dist/content.js"
    },
    "./data": {
      "types": "./dist/types/data/index.d.ts",
      "solid": "./dist/data.jsx",
      "import": "./dist/data.js"
    },
    "./feedback": {
      "types": "./dist/types/feedback/index.d.ts",
      "solid": "./dist/feedback.jsx",
      "import": "./dist/feedback.js"
    },
    "./forms": {
      "types": "./dist/types/forms/index.d.ts",
      "solid": "./dist/forms.jsx",
      "import": "./dist/forms.js"
    },
    "./masking": {
      "types": "./dist/types/forms/masked-input/index.d.ts",
      "solid": "./dist/masking.jsx",
      "import": "./dist/masking.js"
    },
    "./numbers": {
      "types": "./dist/types/forms/number-input/index.d.ts",
      "import": "./dist/numbers.js"
    },
    "./rich-text": {
      "types": "./dist/types/forms/rich-text-editor/index.d.ts",
      "import": "./dist/rich-text.js"
    },
    "./layout": {
      "types": "./dist/types/layout/index.d.ts",
      "solid": "./dist/layout.jsx",
      "import": "./dist/layout.js"
    },
    "./navigation": {
      "types": "./dist/types/navigation/index.d.ts",
      "solid": "./dist/navigation.jsx",
      "import": "./dist/navigation.js"
    },
    "./overlays": {
      "types": "./dist/types/overlays/index.d.ts",
      "solid": "./dist/overlays.jsx",
      "import": "./dist/overlays.js"
    },
    "./postcss": {
      "types": "./dist/postcss.d.ts",
      "import": "./dist/postcss.js"
    },
    "./tailwind/preset.css": "./dist/tailwind/preset.css",
    "./tailwind/foundations.css": "./dist/tailwind/foundations.css",
    "./tailwind/actions.css": "./dist/tailwind/actions.css",
    "./tailwind/forms.css": "./dist/tailwind/forms.css",
    "./tailwind/content.css": "./dist/tailwind/content.css",
    "./tailwind/layout.css": "./dist/tailwind/layout.css",
    "./tailwind/navigation.css": "./dist/tailwind/navigation.css",
    "./tailwind/overlays.css": "./dist/tailwind/overlays.css",
    "./tailwind/feedback.css": "./dist/tailwind/feedback.css",
    "./tailwind/data.css": "./dist/tailwind/data.css",
    "./tailwind/charts.css": "./dist/tailwind/charts.css",
    "./tailwind/compositions.css": "./dist/tailwind/compositions.css"
  },
  "peerDependencies": {
    "solid-js": "^1.9.0",
    "@tailwindcss/postcss": "^4.3.3",
    "postcss": "^8.5.0",
    "tailwindcss": "^4.3.3"
  },
  "dependencies": {
    "@ark-ui/solid": "5.39.3",
    "@internationalized/date": "3.12.4",
    "@solid-primitives/media": "2.3.6",
    "@tiptap/core": "3.33.0",
    "@tiptap/extension-character-count": "3.33.0",
    "@tiptap/extension-placeholder": "3.33.0",
    "@tiptap/html": "3.33.0",
    "@tiptap/pm": "3.33.0",
    "@tiptap/starter-kit": "3.33.0",
    "@unovis/solid": "1.7.1",
    "@unovis/ts": "1.7.1",
    "imask": "7.6.1",
    "lucide-solid": "1.63.0",
    "tailwind-variants": "3.3.1"
  },
  "scripts": {
    "build": "bun scripts/build.ts",
    "typecheck": "tsc --noEmit && tsc --project scripts/tsconfig.json",
    "colors:generate": "bun scripts/generate-colors.ts",
    "measure:charts": "bun scripts/measure-chart-bundles.ts",
    "measure:bundles": "bun scripts/measure-bundles.ts",
    "measure:styles": "bun scripts/measure-styles.ts"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@radix-ui/colors": "3.0.0",
    "@tailwindcss/postcss": "4.3.3",
    "babel-preset-solid": "1.9.16",
    "esbuild": "0.28.2",
    "postcss": "8.5.31",
    "solid-js": "1.9.17",
    "storybook": "10.6.1",
    "storybook-solidjs-vite": "10.7.2",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  },
  "peerDependenciesMeta": {
    "@tailwindcss/postcss": {
      "optional": true
    },
    "postcss": {
      "optional": true
    },
    "tailwindcss": {
      "optional": true
    }
  }
}
