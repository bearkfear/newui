{
  "name": "newui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "solid": "./dist/index.jsx",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./charts": {
      "types": "./dist/types/data/chart/index.d.ts",
      "solid": "./dist/charts.jsx",
      "import": "./dist/charts.js"
    }
  },
  "peerDependencies": {
    "solid-js": "^1.9.0"
  },
  "dependencies": {
    "@ark-ui/solid": "5.39.3",
    "@solid-primitives/media": "2.3.6",
    "@unovis/solid": "1.7.1",
    "@unovis/ts": "1.7.1",
    "lucide-solid": "1.63.0",
    "tailwind-variants": "3.3.1"
  },
  "scripts": {
    "build": "bun scripts/build.ts",
    "typecheck": "tsc --noEmit && tsc --project scripts/tsconfig.json",
    "colors:generate": "bun scripts/generate-colors.ts",
    "measure:charts": "bun scripts/measure-chart-bundles.ts"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@radix-ui/colors": "3.0.0",
    "@tailwindcss/postcss": "4.3.3",
    "babel-preset-solid": "1.9.16",
    "esbuild": "0.28.2",
    "postcss": "8.5.31",
    "solid-js": "1.9.17",
    "storybook": "10.6.1",
    "storybook-solidjs-vite": "10.7.2",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  }
}
