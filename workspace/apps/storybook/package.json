{
  "name": "@newui/storybook",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#storybook-tooling": {
      "types": "./scripts/tooling-entry.ts",
      "default": "./dist/storybook-tooling.mjs"
    }
  },
  "scripts": {
    "build:tooling": "bun scripts/build-tooling.ts",
    "dev": "bun run build:tooling && storybook dev --port 6006 --no-open --disable-telemetry",
    "build": "bun run build:tooling && storybook build --output-dir storybook-static --disable-telemetry",
    "preview:test": "vite preview --outDir storybook-static --host 127.0.0.1 --port 6006 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "test:masking": "playwright test mask-text.spec.ts mask-configuration.spec.ts masked-input.spec.ts",
    "test:ui": "playwright test --ui"
  },
  "dependencies": {
    "solid-js": "1.9.17",
    "@egcs/newui": "workspace:*"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@radix-ui/colors": "3.0.0",
    "@storybook/addon-a11y": "10.6.1",
    "@storybook/addon-docs": "10.6.1",
    "@storybook/addon-links": "10.6.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "esbuild": "0.28.2",
    "postcss": "8.5.31",
    "react": "19.3.1",
    "storybook": "10.6.1",
    "storybook-solidjs-vite": "10.7.2",
    "typescript": "5.9.3",
    "vite": "7.3.5",
    "vite-plugin-solid": "2.11.14"
  }
}
