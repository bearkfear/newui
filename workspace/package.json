{
  "name": "newui",
  "description": "Development monorepo for @egcs/newui, a composable SolidJS UI component library.",
  "private": true,
  "license": "MIT",
  "homepage": "https://github.com/bearkfear/newui#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bearkfear/newui.git",
    "directory": "workspace"
  },
  "bugs": {
    "url": "https://github.com/bearkfear/newui/issues"
  },
  "keywords": [
    "newui",
    "solid-js",
    "ui-library",
    "design-system",
    "documentation",
    "tailwindcss",
    "bun-workspaces",
    "monorepo"
  ],
  "type": "module",
  "packageManager": "bun@1.3.13",
  "workspaces": [
    "apps/*",
    "pkgs/*"
  ],
  "scripts": {
    "dev": "bun run docs",
    "docs": "bun run --cwd apps/docs dev",
    "build": "bun run --cwd pkgs/ui build",
    "build:docs": "bun run --cwd apps/docs build",
    "typecheck": "bun run --cwd pkgs/ui typecheck && bun run --cwd apps/docs typecheck && tsc --project scripts/tsconfig.json",
    "pack": "bun scripts/ci/pack.ts",
    "test:masking": "bun test pkgs/ui/tests",
    "lint": "biome lint . --error-on-warnings",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check . --error-on-warnings && bun run typecheck",
    "check:fix": "biome check --write .",
    "hooks:install": "simple-git-hooks",
    "prepare": "simple-git-hooks"
  },
  "patchedDependencies": {
    "@zag-js/focus-visible@1.45.0": "patches/@zag-js%2Ffocus-visible@1.45.0.patch"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@types/babel__core": "7.20.5",
    "@types/bun": "1.4.4",
    "simple-git-hooks": "2.14.0",
    "typescript": "5.9.3"
  },
  "simple-git-hooks": {
    "pre-commit": "cd workspace && bun run check",
    "preserveUnused": true
  }
}
