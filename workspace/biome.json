{
  "$schema": "https://biomejs.dev/schemas/2.6.2/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true,
    "root": ".."
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!!**/node_modules",
      "!!**/dist",
      "!!references/_local",
      "!!patches",
      "!!pkgs/ui/foundations/radix.css",
      "!!apps/docs/src/i18n/i18n-solid.ts",
      "!!apps/docs/src/i18n/i18n-types.ts",
      "!!apps/docs/src/i18n/i18n-util.ts",
      "!!apps/docs/src/i18n/i18n-util.async.ts",
      "!!apps/docs/src/i18n/i18n-util.sync.ts",
      "!!bun.lock"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "lf"
  },
  "javascript": {
    "jsxRuntime": "transparent",
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "style": {
        "noDefaultExport": "error",
        "noExcessiveLinesPerFile": {
          "level": "error",
          "options": {
            "maxLines": 250,
            "skipBlankLines": false
          }
        }
      },
      "complexity": {
        "noExcessiveLinesPerFunction": {
          "level": "error",
          "options": {
            "maxLines": 60,
            "skipBlankLines": false,
            "skipIifes": false
          }
        },
        "noExcessiveCognitiveComplexity": {
          "level": "error",
          "options": {
            "maxAllowedComplexity": 15
          }
        },
        "useLiteralKeys": "off"
      },
      "correctness": {
        "useJsxKeyInIterable": "off"
      },
      "suspicious": {
        "noUnknownAtRules": {
          "level": "error",
          "options": { "ignore": ["newui"] }
        }
      },
      "preset": "recommended"
    }
  },
  "overrides": [
    {
      "includes": [
        "apps/docs/src/routes/**",
        "apps/docs/src/app.tsx",
        "apps/docs/src/entry-server.tsx",
        "apps/docs/vite.config.ts",
        "apps/docs/postcss.config.mjs",
        "apps/docs/src/i18n/en/index.ts",
        "apps/docs/src/i18n/pt-BR/index.ts",
        "apps/docs/src/i18n/i18n-util.sync.ts",
        "apps/docs/src/i18n/i18n-util.async.ts",
        "apps/docs/src/i18n/i18n-solid.ts",
        "pkgs/ui/scripts/consumer-postcss.ts",
        "**/*.d.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noDefaultExport": "off"
          }
        }
      }
    }
  ]
}
